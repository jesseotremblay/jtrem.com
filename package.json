{
  "name": "my-site-paper-template",
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && jampack ./dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "cz": "cz",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" --fix",
    "lint:check": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\"",
    "posse": "node posse.js",
    "posse:latest": "node posse.js",
    "posse:help": "node posse.js --help",
    "webmentions:test": "node test-webmentions.js",
    "webmentions:help": "node test-webmentions.js --help",
    "posse:test": "curl -s -I https://jtrem.com/posts/what-operator-shows-us-about-tomorrows-web | grep -E '(HTTP|Content-Type|Last-Modified)'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@atproto/api": "^0.13.6",
    "@resvg/resvg-js": "^2.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "latest": "^0.2.0",
    "lru-cache": "^11.5.2",
    "n": "^11.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.12",
    "@divriots/jampack": "^0.34.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.4",
    "@types/github-slugger": "^1.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "astro-eslint-parser": "^3.1.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-img-size": "^1.0.1",
    "rehype-plugin-image-native-lazy-loading": "^1.2.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,astro}": [
      "prettier --write --plugin=prettier-plugin-astro"
    ]
  }
}
